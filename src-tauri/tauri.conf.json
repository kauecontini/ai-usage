{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage",
  "version": "0.1.0",
  "identifier": "com.usage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Usage",
        "width": 240,
        "height": 36,
        "minWidth": 240,
        "minHeight": 36,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "ChatGPT/Codex and Claude usage at a glance.",
    "longDescription": "A tiny local-first Windows utility that shows remaining ChatGPT/Codex and Claude subscription usage.",
    "copyright": "Copyright © 2026 Usage contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
